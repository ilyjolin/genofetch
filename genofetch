    ]
    packages = [
        "842 (pacman)", "1240 (dpkg / rpm)", 
        "690 (xbps)", "2150 (apt / dpkg)"
    ]

    return {
        "os": get_randomized_os(),
        "kernel": random.choice(kernels),
        "uptime": random.choice(uptimes),
        "packages": random.choice(packages),
        "shell": "zsh 5.9",
        "cpu": selected["cpu"],
        "gpu": selected["gpu"],
        "memory": selected["ram"],
        "network": "[REDACTED / SECURE]"
    }

def main():
    cyan = "\033[1;36m"
    reset = "\033[0m"
    
    tier = load_tier()
    specs = get_matched_hardware(tier)
    
    info = [
        f"{cyan}OS{reset}: {specs['os']}",
        f"{cyan}Kernel{reset}: {specs['kernel']}",
        f"{cyan}Uptime{reset}: {specs['uptime']}",
        f"{cyan}Packages{reset}: {specs['packages']}",
        f"{cyan}Shell{reset}: {specs['shell']}",
        f"{cyan}CPU{reset}: {specs['cpu']}",
        f"{cyan}GPU{reset}: {specs['gpu']}",
        f"{cyan}Memory{reset}: {specs['memory']}",
        f"{cyan}Network{reset}: {specs['network']}"
    ]
    
    logo_lines = LOGO.strip("\n").split("\n")
    max_logo_width = max(len(line) for line in logo_lines) if logo_lines else 10
    
    for i in range(max(len(logo_lines), len(info))):
        l_part = logo_lines[i] if i < len(logo_lines) else " " * max_logo_width
        r_part = info[i] if i < len(info) else ""
        print(f"{cyan}{l_part:<{max_logo_width + 4}}{reset}{r_part}")

if __name__ == "__main__":
    main()
