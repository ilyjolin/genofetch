            "gpu": "AMD Radeon RX 7900 XT",
            "ram": "31200MiB / 65536MiB"
        }
    ]

    # Weighted resolution logic (34% Low, 40% Mid, 26% High)
    if tier == "low":
        selected = random.choice(low_tier_pool)
    elif tier == "mid":
        selected = random.choice(mid_tier_pool)
    elif tier == "high":
        selected = random.choice(high_tier_pool)
    else:
        roll = random.randint(1, 100)
        if roll <= 34:
            selected = random.choice(low_tier_pool)
        elif roll <= 74:
            selected = random.choice(mid_tier_pool)
        else:
            selected = random.choice(high_tier_pool)

    kernels = [
        "6.11.2-custom-x86_64", "6.10.9-hardened-1",
        "6.12.0-rc6-zen", "6.9.7-arch1-1", "6.8.0-45-generic"
