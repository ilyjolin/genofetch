"""

CONFIG_FILE = os.path.expanduser("~/.config/genofetch/tier.conf")

def load_tier():
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r") as f:
                tier = f.read().strip()
                if tier in ["low", "mid", "high", "realistic"]:
                    return tier
        except:
            pass
    return "realistic"

def get_randomized_os():
    os_pool = [
        "Arch Linux x86_64",
        "Linux From Scratch (LFS)",
        "Debian GNU/Linux 12 (bookworm)",
        "Void Linux x86_64",
        "Gentoo Linux Base System"
    ]
    return random.choice(os_pool)

