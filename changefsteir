#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import os

CONFIG_DIR = os.path.expanduser("~/.config/genofetch")
CONFIG_FILE = os.path.join(CONFIG_DIR, "tier.conf")

def get_current_tier():
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r") as f:
                return f.read().strip()
        except:
            pass
    return "realistic"

def save_tier(tier):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(CONFIG_FILE, "w") as f:
        f.write(tier)

def main():
    current = get_current_tier()
    
    options = [
        ("low", "Low Tier (Entry-level chips & lighter memory setups)"),
        ("mid", "Mid Tier (Balanced everyday workhorses)"),
        ("high", "High Tier (Extreme cutting-edge desktop/mobile powerhouses)"),
        ("realistic", "Realistic Tier (Weighted mix: 34% Low, 40% Mid, 26% High)")
    ]

    print("\033[1;36m=== Genofetch Hardware Tier Configuration ===\033[0m")
    print("Select your target spoofed performance profile:\n")

    for idx, (key, desc) in enumerate(options, 1):
        mark = "[X]" if current == key else "[ ]"
        print(f"  {idx}) {mark} {desc}")

    choice = input("\nEnter choice (1-4): ").strip()
    mapping = {"1": "low", "2": "mid", "3": "high", "4": "realistic"}
    
    if choice in mapping:
        selected = mapping[choice]
        save_tier(selected)
        print(f"\n\033[1;32m[+] Successfully updated tier to: {selected.upper()}\033[0m")
    else:
        print("\n\033[1;31m[-] Invalid selection. No changes made.\033[0m")

if __name__ == "__main__":
    main()
